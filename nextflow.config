/*
 * Runtime values are supplied by scratch.slurm through PGTK_* environment variables.
 * Three total attempts: 1x, 2x and 4x. CPU cap 32, memory cap 512 GB.
 * Route to bigmem when the effective request exceeds 20 CPUs or 160 GB.
 */
process {
    executor = 'slurm'
    container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
    clusterOptions = "--account=${env('PGTK_ACCOUNT')}"
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
    maxErrors = -1
    queue = {
        task.cpus > Math.min((env('PGTK_NORMAL_CPU_THRESHOLD') as int), 20) || task.memory > Math.min((env('PGTK_NORMAL_MEMORY_THRESHOLD_GB') as int), 160).GB
            ? env('PGTK_BIGMEM_PARTITION')
            : env('PGTK_NORMAL_PARTITION')
    }
}

executor {
    queueSize = env('PGTK_QUEUE_SIZE') as int
    submitRateLimit = env('PGTK_SUBMIT_RATE_LIMIT')
}

trace {
    enabled = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,time,queue,workdir,error_action'
}
timeline.enabled = true
report.enabled = true
dag.enabled = true

profiles {
    robust {
        process {
            withName: COUNT_GENES_PER_SAMPLE {
            cpus = { Math.min(Math.min((env('PGTK_MAX_CPUS') as int), 32), 4 * (1 << (task.attempt - 1))) }
            memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '4h'
        }
        withName: MERGE_GENE_EXPRESSION {
            cpus = { 1 }
            memory = { def value = 8.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '4h'
        }
        withName: ANALYZE_EXPRESSION_SAMPLE_GO {
            cpus = { 1 }
            memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '1h'
        }
        withName: ANALYZE_EXPRESSION_RANKED_GO {
            cpus = { 1 }
            memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '1h'
        }
        withName: MERGE_EXPRESSION_GO {
            cpus = { 1 }
            memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '1h'
        }
        withName: PREPARE_EXPRESSION_MULTIQC_CONTENT {
            cpus = { 1 }
            memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '1h'
        }
        withName: ANALYZE_PROGRESSION_VARIANT_SETS {
            cpus = { 1 }
            memory = { def value = 8.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
            time = '8h'
        }
        withName: PREPARE_GO_ANNOTATIONS {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: ANALYZE_PROGRESSION_SAMPLE {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: COMPARE_PROGRESSION_PAIR {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '2h'
            }
            withName: MERGE_PROGRESSION_BIOLOGY {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: ANALYZE_CODON_MISMATCHES {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '1h'
            }
            withName: ANALYZE_MAXQUANT_JUNCTIONS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: ANNOTATE_MAXQUANT_VARIANTS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '2h'
            }
            withName: ARRIBA {
                cpus = { 1 }
                memory = { def value = 24.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '3h'
            }
            withName: VALIDATE_HAPLOTYPE_SHARDS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '2h'
            }
            withName: VARIANT_STAGE_QC {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '2h'
            }
            withName: COMPARE_EXTERNAL_VCF {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: BCFTOOLS_STATS {
                cpus = { 2 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '1h'
