                time = '1h'
            }
            withName: MULTIQC_FINAL {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
