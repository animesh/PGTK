// ─────────────────────────────────────────────────────────────────────────────
// Nextflow config — RNA-seq Somatic Variant Calling (FASTQ → SNV/SV)
// ─────────────────────────────────────────────────────────────────────────────

params {
    samplesheet = "${projectDir}/samples.csv"
    genome      = "/mnt/z/Download/TK/genome.fa"
    gtf         = "/mnt/z/Download/TK/Homo_sapiens.GRCh38.110.gtf"
    star_index    = null    // set to a path to skip STAR_GENOMEGENERATE
    read_length   = 150     // used to set --sjdbOverhang (read_length - 1 = 149)
    skip_trimming = false   // set to true to bypass TRIM_GALORE
    outdir        = "${projectDir}/results"

    // BQSR — Base Quality Score Recalibration
    // Provide a dbSNP VCF (bgzipped + tabix-indexed) to enable BQSR.
    // The .tbi index must sit alongside the VCF at <dbsnp>.tbi
    // Download: https://ftp.ncbi.nlm.nih.gov/snp/latest_release/VCF/
    //   e.g. GCF_000001405.40.gz  (GRCh38, dbSNP b156+)
    // Set to null or skip_bqsr = true to skip recalibration.
    dbsnp      = "/mnt/z/Download/TK/dbsnp_vcfs/dbsnp.vcf.gz"
    skip_bqsr  = false  // set to true to bypass BQSR even if dbsnp is set
}

// ── Process resource labels ───────────────────────────────────────────────────
process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '8 GB'
        time   = '2 h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '16 GB'
        time   = '8 h'
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = '48 GB'
        time   = '24 h'
    }

    // STAR genome generate needs more memory for GRCh38
    withName: 'STAR_GENOMEGENERATE' {
        cpus   = 12
        memory = '64 GB'
        time   = '4 h'
    }

    // STAR alignment is the most memory-hungry step
    withName: 'STAR_ALIGN' {
        cpus   = 12
        memory = '48 GB'
        time   = '12 h'
    }
}

// ── Docker ────────────────────────────────────────────────────────────────────
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
    temp       = 'auto'
}

// ── Executor ──────────────────────────────────────────────────────────────────
executor {
    name      = 'local'
    cpus      = 12
    memory    = '78 GB'
    queueSize = 1        // one job at a time — each gets all 12 CPUs
}

// ── Strict syntax ─────────────────────────────────────────────────────────────
nextflow {
    enable.strict = true
}

// ── Reports ───────────────────────────────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite  = true
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    debug {
        process.errorStrategy = 'terminate'
        cleanup               = false
    }
    // Use a pre-built STAR index to skip genome generation:
    //   nextflow run main.nf -profile with_index --star_index /path/to/index
    with_index {
        params.star_index = null  // override on CLI: --star_index /path
    }
}
