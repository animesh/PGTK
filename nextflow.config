                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
