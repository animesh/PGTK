            }
            withName: HAPLOTYPE_CALLER {
                cpus = { Math.min(Math.min((env('PGTK_MAX_CPUS') as int), 32), 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '4h'
            }
            withName: MAP_MAXQUANT_PEPTIDES {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '2h'
            }
            withName: MARK_DUPLICATES {
                cpus = { 2 }
                memory = { def value = 48.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
                time = '3h'
            }
            withName: MERGE_VARIANT_CODON_VALIDATION {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB ? Math.min((env('PGTK_MAX_MEMORY_GB') as int), 512).GB : value }
