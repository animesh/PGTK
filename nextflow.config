/*
 * Runtime values are supplied by scratch.slurm through PGTK_* environment variables.
 * Three total attempts: 1x, 2x and 4x. CPU cap 32, memory cap 512 GB.
 * Route to bigmem when the effective request exceeds 20 CPUs or 160 GB.
 */
def requiredEnv = { String name ->
    def value = System.getenv(name)
    if (!value) throw new IllegalStateException("Required environment variable is missing: ${name}")
    value
}
def pgtkAccount = requiredEnv('PGTK_ACCOUNT')
def pgtkNormalPartition = requiredEnv('PGTK_NORMAL_PARTITION')
def pgtkBigmemPartition = requiredEnv('PGTK_BIGMEM_PARTITION')
def pgtkNormalCpuThreshold = requiredEnv('PGTK_NORMAL_CPU_THRESHOLD') as int
def pgtkNormalMemoryThresholdGb = requiredEnv('PGTK_NORMAL_MEMORY_THRESHOLD_GB') as int
def pgtkMaxCpus = requiredEnv('PGTK_MAX_CPUS') as int
def pgtkMaxMemoryGb = requiredEnv('PGTK_MAX_MEMORY_GB') as int
def pgtkQueueSize = requiredEnv('PGTK_QUEUE_SIZE') as int
def pgtkSubmitRateLimit = requiredEnv('PGTK_SUBMIT_RATE_LIMIT')
def pgtkAbsoluteNormalCpuThreshold = 20
def pgtkAbsoluteNormalMemoryThresholdGb = 160
def pgtkAbsoluteMaxCpus = 32
def pgtkAbsoluteMaxMemoryGb = 512
def pgtkEffectiveNormalCpuThreshold = Math.min(pgtkNormalCpuThreshold, pgtkAbsoluteNormalCpuThreshold)
def pgtkEffectiveNormalMemoryThresholdGb = Math.min(pgtkNormalMemoryThresholdGb, pgtkAbsoluteNormalMemoryThresholdGb)
def pgtkEffectiveMaxCpus = Math.min(pgtkMaxCpus, pgtkAbsoluteMaxCpus)
def pgtkEffectiveMaxMemoryGb = Math.min(pgtkMaxMemoryGb, pgtkAbsoluteMaxMemoryGb)

process {
    executor = 'slurm'
    container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
    clusterOptions = "--account=${pgtkAccount}"
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
    maxErrors = -1
    queue = {
        task.cpus > pgtkEffectiveNormalCpuThreshold || task.memory > pgtkEffectiveNormalMemoryThresholdGb.GB
            ? pgtkBigmemPartition
            : pgtkNormalPartition
    }
}

executor {
    queueSize = pgtkQueueSize
    submitRateLimit = pgtkSubmitRateLimit
}

trace {
    enabled = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,time,queue,workdir,error_action'
}
timeline.enabled = true
report.enabled = true
dag.enabled = true

profiles {
    robust {
        process {
            withName: PREPARE_GO_ANNOTATIONS {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: ANALYZE_PROGRESSION_SAMPLE {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: COMPARE_PROGRESSION_PAIR {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: MERGE_PROGRESSION_BIOLOGY {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: ANALYZE_CODON_MISMATCHES {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: ANALYZE_MAXQUANT_JUNCTIONS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: ANNOTATE_MAXQUANT_VARIANTS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: ARRIBA {
                cpus = { 1 }
                memory = { def value = 24.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '3h'
            }
            withName: VALIDATE_HAPLOTYPE_SHARDS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VARIANT_STAGE_QC {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: COMPARE_EXTERNAL_VCF {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: BCFTOOLS_STATS {
                cpus = { 2 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: BUILD_COMPARATIVE_ADVANTAGE_REPORT {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '8h'
            }
            withName: PREPARE_COMPARATIVE_MULTIQC_CONTENT {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: BUILD_IGV_EVIDENCE_BUNDLE {
                cpus = { 2 }
                memory = { def value = 8.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '24h'
            }
            withName: BUILD_COMPLETE_FINDINGS_REPORT {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: BUILD_INTEGRATED_VARIANT_EVIDENCE {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: BUILD_PROTEOGENOMICS_EVIDENCE_REPORT {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: CAT_FASTQ {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: COMBINE_PROTEIN_FASTA {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: DOWNLOAD_REFERENCES {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: FASTQC_RAW {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: FASTQC_TRIMMED {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: FUSION_FASTA {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: GATHER_HAPLOTYPE_GVCF {
                cpus = { 2 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: GENOTYPE_FILTER {
                cpus = { 2 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: GFFCOMPARE_NOVEL {
                cpus = { 2 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: HAPLOTYPE_CALLER {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: MAP_MAXQUANT_PEPTIDES {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: MARK_DUPLICATES {
                cpus = { 2 }
                memory = { def value = 48.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '3h'
            }
            withName: MERGE_VARIANT_CODON_VALIDATION {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: MERGE_VARIANT_READ_PROVENANCE {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: MULTIQC_FINAL {
                cpus = { 1 }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: MULTIQC_QC_DATA {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: PREPARE_FINAL_MULTIQC_CONTENT {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: PREPARE_HAPLOTYPE_INTERVALS {
                cpus = { 2 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: PROGRESSION_SUBTRACT {
                cpus = { 2 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: PYPGATK_FASTA {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: REF_INDEX {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: SAMTOOLS_FLAGSTAT {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 3 * (1 << (task.attempt - 1))) }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: SORT_INDEX_BAM {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 8 * (1 << (task.attempt - 1))) }
                memory = { def value = 24.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: SPLICE_PROTEIN_FASTA {
                cpus = { 2 }
                memory = { def value = 6.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '3h'
            }
            withName: SPLIT_N_CIGAR {
                cpus = { 2 }
                memory = { def value = 24.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '16h'
            }
            withName: SRA_TO_FASTQ {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '6h'
            }
            withName: STAR_ALIGN {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 32 * (1 << (task.attempt - 1))) }
                memory = { def value = 64.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '6h'
            }
            withName: STAR_INDEX {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 16 * (1 << (task.attempt - 1))) }
                memory = { def value = 48.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '3h'
            }
            withName: STRINGTIE_ASSEMBLY {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 3.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: TRIM_GALORE {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 8 * (1 << (task.attempt - 1))) }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '3h'
            }
            withName: VALIDATE_MAXQUANT_INPUTS {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: VALIDATE_MAXQUANT_SPLICE_JUNCTIONS {
                cpus = { 2 }
                memory = { def value = 3.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VALIDATE_PROTEOGENOMIC_READS {
                cpus = { 1 }
                memory = { def value = 32.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '4h'
            }
            withName: VALIDATE_RNA_FUSIONS {
                cpus = { 1 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '1h'
            }
            withName: VALIDATE_RNA_SPLICE_TRANSCRIPTS {
                cpus = { 2 }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VALIDATE_RNA_VARIANTS {
                cpus = { 1 }
                memory = { def value = 2.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VALIDATE_VARIANT_CODONS {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 1.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VALIDATE_VARIANT_READ_PROVENANCE {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 2 * (1 << (task.attempt - 1))) }
                memory = { def value = 12.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
            withName: VEP_ANNOTATE {
                cpus = { Math.min(pgtkEffectiveMaxCpus, 12 * (1 << (task.attempt - 1))) }
                memory = { def value = 4.GB * (1 << (task.attempt - 1)); value > pgtkEffectiveMaxMemoryGb.GB ? pgtkEffectiveMaxMemoryGb.GB : value }
                time = '2h'
            }
        }
    }
}
